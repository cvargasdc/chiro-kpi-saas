# Copy to .env for local development. Never commit real secrets.
# Generate SESSION_SECRET with: openssl rand -hex 32

NODE_ENV=development
PORT=5000

# Local docker-compose Postgres (see docker-compose.yml)
DATABASE_URL=postgres://chirokpi:chirokpi_local@localhost:5432/chirokpi

# Required in production. In development the server will refuse to start
# without this value — there is no hardcoded fallback.
SESSION_SECRET=replace-with-a-long-random-string

# Cookie flags. Production always forces secure + sameSite=strict.
COOKIE_SECURE=false

# Encrypts TOTP secrets at rest (AES-256-GCM). Required to start the server.
# Generate with: openssl rand -hex 32
MFA_ENCRYPTION_KEY=replace-with-a-long-random-string-min-32-chars

# Encrypts patient email, phone, and date of birth at rest (AES-256-GCM).
# Must be distinct from MFA_ENCRYPTION_KEY. Generate with: openssl rand -hex 32
PHI_ENCRYPTION_KEY=replace-with-a-different-long-random-string-32

# Used in password-reset and invite links (stub mailer does not send).
APP_BASE_URL=http://localhost:5000

# Optional. Redirect HTTP→HTTPS. Leave false behind App Runner / ALB
# (TLS already terminates at the load balancer).
# FORCE_HTTPS=false

# Optional. Trust X-Forwarded-* (production always trusts the first proxy).
# TRUST_PROXY=false

# Week 3 does not send via Resend. See docs/WEEK3-AUTH.md to plug in later.
# RESEND_API_KEY=
# RESEND_FROM=Chiro-KPI <noreply@example.com>

# Stripe test mode only. Never commit sk_live_ / whsec live values.
# Do not put patient names, patient emails, DOB, or other PHI in Stripe.
# See docs/WEEK5-BILLING.md.
# STRIPE_SECRET_KEY=sk_test_your_test_secret_key
# STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key
# STRIPE_WEBHOOK_SECRET=whsec_your_cli_or_dashboard_secret
# STRIPE_PRICE_ID=price_your_test_price_id
# BILLING_REQUIRE_STRIPE=false
# BILLING_ENFORCE=false
# BILLING_TRIAL_DAYS=14
