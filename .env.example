# Copy to .env for local development. Never commit real secrets.
# Generate SESSION_SECRET with: openssl rand -hex 32

NODE_ENV=development
PORT=5000

# Local docker-compose Postgres (see docker-compose.yml)
DATABASE_URL=postgres://chirokpi:chirokpi_local@localhost:5432/chirokpi

# Required in production. In development the server will refuse to start
# without this value — there is no hardcoded fallback.
SESSION_SECRET=replace-with-a-long-random-string

# Cookie flags. Production always forces secure + sameSite=strict.
COOKIE_SECURE=false
