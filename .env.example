# Copy to .env for local development. Never commit real secrets.
# Generate SESSION_SECRET with: openssl rand -hex 32

NODE_ENV=development
PORT=5000

# Local docker-compose Postgres (see docker-compose.yml)
DATABASE_URL=postgres://chirokpi:chirokpi_local@localhost:5432/chirokpi

# Required in production. In development the server will refuse to start
# without this value — there is no hardcoded fallback.
SESSION_SECRET=replace-with-a-long-random-string

# Cookie flags. Production always forces secure + sameSite=strict.
COOKIE_SECURE=false

# Encrypts TOTP secrets at rest (AES-256-GCM). Required to start the server.
# Generate with: openssl rand -hex 32
MFA_ENCRYPTION_KEY=replace-with-a-long-random-string-min-32-chars

# Used in password-reset and invite links (stub mailer does not send).
APP_BASE_URL=http://localhost:5000

# Week 3 does not send via Resend. See docs/WEEK3-AUTH.md to plug in later.
# RESEND_API_KEY=
# RESEND_FROM=Chiro-KPI <noreply@example.com>
