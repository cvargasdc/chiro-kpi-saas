# Copy to terraform.tfvars (gitignored) and fill values.
# Never commit real secrets, account numbers with PHI notes, or production keys.

aws_region   = "us-east-1"
name_prefix  = "chirokpi-staging"

# VPC
vpc_cidr = "10.40.0.0/16"
az_count = 2

# RDS (private, KMS-encrypted). Password is generated by Terraform and
# written into Secrets Manager — do not put passwords here.
db_instance_class        = "db.t4g.micro"
db_name                  = "chirokpi"
db_username              = "chirokpi_admin"
db_allocated_storage     = 20
db_backup_retention_days = 7

# App Runner — leave enable_apprunner=false for first apply (networking + RDS +
# secrets + ECR). After docker push to the ECR output, set:
#   enable_apprunner = true
#   container_image  = "<account>.dkr.ecr.us-east-1.amazonaws.com/chirokpi-staging:SHA"
enable_apprunner = false
container_image  = ""

app_port   = 5000
app_cpu    = "1024"
app_memory = "2048"

cloudwatch_retention_days = 30
create_uploads_bucket     = true
